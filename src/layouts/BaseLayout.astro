---
import '@/styles/fonts.css';
import '@/styles/tokens.css';
import '@/styles/base.css';
import '@/styles/components.css';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import {
  LOCALE_META,
  LOCALES,
  swapLocale,
  pathWithoutLocale,
  type Locale,
} from '@i18n/config';
import { useTranslations } from '@i18n/ui';
import { churchJsonLd } from '@lib/church';

interface Props {
  locale: Locale;
  title: string;
  description?: string;
  /** Social share image, absolute or site-relative. */
  ogImage?: string;
  /** Suppress the header’s translucent-over-hero treatment. */
  solidHeader?: boolean;
  noindex?: boolean;
  bodyClass?: string;
}

const {
  locale,
  title,
  description,
  ogImage,
  solidHeader = false,
  noindex = false,
  bodyClass = '',
} = Astro.props;

const t = useTranslations(locale);
const meta = LOCALE_META[locale];
const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const here = pathWithoutLocale(Astro.url.pathname);

const fullTitle =
  title === t('site.name') ? title : `${title} · ${t('site.name')}`;
const desc = description ?? t('site.description');
const canonical = `${site}${Astro.url.pathname.replace(/\/$/, '') || `/${locale}`}`;
const ogImageUrl = ogImage
  ? ogImage.startsWith('http')
    ? ogImage
    : `${site}${ogImage}`
  : `${site}/og-default.png`;

const jsonLd = await churchJsonLd(locale, site);
---

<!doctype html>
<html lang={meta.tag} dir={meta.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    {/* --- Bilingual SEO ------------------------------------------------ */}
    {
      LOCALES.map((l) => (
        <link
          rel="alternate"
          hreflang={LOCALE_META[l].tag}
          href={`${site}${swapLocale(Astro.url.pathname, l)}`}
        />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={`${site}/en${here === '/' ? '' : here}`} />

    {/* --- Fonts --------------------------------------------------------
        Self-hosted and subset to the glyphs this site actually uses.

        Google Fonts was serving 1.8 MB on /en and 2.7 MB on /zh — it splits
        the CJK faces into ~100 generic buckets and this site’s text lands in
        dozens of them. Subsetting to the 676 Chinese characters the church
        has actually written takes a /zh page from 2716 KB to 265 KB, removes
        a 227 KB render-blocking third-party stylesheet, and drops the
        third-party connection entirely.

        Only the two Chinese SERIF weights are webfonted; Chinese UI labels
        use the system sans already in the stack. See scripts/build-fonts.mjs.
        ------------------------------------------------------------------ */}
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/source-serif-4-400.woff2"
      crossorigin
    />
    {
      locale === 'zh' && (
        <link
          rel="preload"
          as="font"
          type="font/woff2"
          href="/fonts/noto-serif-sc-rest-400.woff2"
          crossorigin
        />
      )
    }

    {/* --- Social ------------------------------------------------------- */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t('site.name')} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content={meta.ogLocale} />
    {
      LOCALES.filter((l) => l !== locale).map((l) => (
        <meta property="og:locale:alternate" content={LOCALE_META[l].ogLocale} />
      ))
    }
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#14110e" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {/* Structured data so Google can answer "what time is the Chinese church
        in Waco on Sunday?" directly in the results. */}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    {/* Enables the JS reveal fallback only where scroll-driven CSS is absent,
        and only when the visitor has not asked for reduced motion. */}
    <script is:inline>
      (function () {
        try {
          var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          var native = CSS.supports('animation-timeline: view()');
          if (!reduce && !native) document.documentElement.classList.add('js-reveal');
        } catch (e) {}
      })();
    </script>
  </head>

  <body class={bodyClass}>
    <a class="skip-link ui" href="#main">{t('nav.skip')}</a>

    <Header locale={locale} transparent={!solidHeader} />

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <Footer locale={locale} />

    <script>
      import '@/scripts/reveal';
      import '@/scripts/freshness';
    </script>

    <style>
      .skip-link {
        position: absolute;
        inset-inline-start: var(--s-4);
        inset-block-start: var(--s-4);
        z-index: var(--z-skip);
        padding: var(--s-3) var(--s-5);
        background: var(--c-ink-900);
        color: var(--c-paper);
        border-radius: var(--r-md);
        font-size: var(--fs-sm);
        font-weight: 600;
        text-decoration: none;
        transform: translateY(-160%);
        transition: transform var(--dur-base) var(--ease-out-soft);
      }

      .skip-link:focus {
        transform: translateY(0);
      }

      main:focus {
        outline: none;
      }
    </style>
  </body>
</html>
