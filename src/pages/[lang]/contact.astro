---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHeader from '@components/PageHeader.astro';
import SectionHeader from '@components/SectionHeader.astro';
import InviteBlock from '@components/InviteBlock.astro';
import { LOCALES, pick, type Locale } from '@i18n/config';
import { useTranslations } from '@i18n/ui';
import { getChurch, getFellowships } from '@lib/church';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const t = useTranslations(locale);

const church = await getChurch();

/*
  The contact form only exists when there is a real key to send with.

  Web3Forms, like every form service, will only deliver to an address whose
  owner confirmed it, which is the whole point: otherwise anyone could aim it
  at anyone. Nobody working on this site can open the church's inbox to click
  that confirmation, so until someone who can does it, there is no key.

  A form with a placeholder key renders perfectly, submits, shows the thank-you
  message and throws the message away. On the only contact route this church
  publishes, that is the worst failure available. So with no key the form is
  not rendered at all and the page falls back to the address, which is already
  how the rest of the site asks people to get in touch.

  To switch it on: get a free key at web3forms.com using the church address,
  and put it in church.yaml under contact.formKey. One line, no developer, no
  redeploy beyond the usual.
*/
const formKey = church.contact.formKey;
const hasForm = Boolean(formKey) && formKey !== 'WEB3FORMS_ACCESS_KEY_HERE';

/* The three named fellowship contacts the church publishes. None has an
   email address attached, so the page says who they’re and routes the
   message through the church address rather than inventing a mailbox. */
const contacts = (await getFellowships()).filter(
  (f) => f.data.contactStatus !== 'unverified' && pick(f.data.contactName, locale),
);

const social = church.social.filter((s) => s.status !== 'unverified');
---

<BaseLayout
  locale={locale}
  title={t('contact.title')}
  description={locale === 'en'
    ? 'Get in touch with Waco Chinese Church at 1801 Gurley Avenue, Waco, Texas. Email us, get directions, or find out who to ask about each fellowship. Write in English or Chinese.'
    : '与德州韦科华人教会联系。教会位于 1801 Gurley Avenue，您可以写信给我们、查看路线，或找到各团契的联系人。中文或英文留言皆可。'}
>
  <PageHeader
    locale={locale}
    eyebrow={t('contact.title')}
    title={locale === 'en' ? 'Talk to a person' : '与我们当中的一位谈谈'}
    lede={t('contact.lede')}
  />

  <section class="section" aria-labelledby="form-title">
    <div class="shell">
      <div class="contact">
        {/* ------------------------------------------------------------- */}
        {/* FORM — Netlify Forms. Free, no server, no database, and the     */}
        {/* church receives submissions by email. `netlify` + a honeypot    */}
        {/* is the whole integration. Degrades to a plain mailto link if    */}
        {/* the site is ever hosted somewhere without form handling.        */}
        {/* ------------------------------------------------------------- */}
        <div class="contact__form-wrap" data-reveal>
          <h2 class="contact__title" id="form-title">
            {hasForm
              ? locale === 'en'
                ? 'Send a message'
                : '给我们留言'
              : locale === 'en'
                ? 'Write to us'
                : '写信给我们'}
          </h2>

          {!hasForm && (
            <div class="contact__email-first">
              <p class="contact__email-lede">
                {locale === 'en'
                  ? 'Email is the way to reach this church. A real person reads it, and you can write in English or Chinese.'
                  : '写信是联系教会最直接的方式。信箱有真人查看，中文或英文都可以。'}
              </p>
              <p class="contact__email-big">
                <a href={`mailto:${church.contact.email}`}>{church.contact.email}</a>
              </p>
              <p class="contact__email-note ui">
                {locale === 'en'
                  ? 'Plenty of people write about the same few things: coming for the first time, how to find the building, or asking the church to pray for something. Any of those is welcome.'
                  : '大家来信问得最多的，无非是几件事：第一次想来、找不到地方、或者请教会为一件事祷告。哪一样都欢迎。'}
              </p>
            </div>
          )}

          {/* The form posts to ?sent=1. On a static site nothing renders that
              by itself, so the confirmation is pre-rendered hidden and
              revealed from the query string.

              role="status" alone did NOT announce it. A live region only
              announces content that changes while it’s being watched, and
              this text is present from the first byte and merely hidden — so
              a screen reader user submitted the form and was told nothing.
              Focus is moved to it instead, which is both reliable and what a
              keyboard user expects after a submit. */}
          {hasForm && (
          <div class="form-sent" id="form-sent" role="status" tabindex="-1" hidden>
            <p class="form-sent__title">{t('contact.sentTitle')}</p>
            <p class="form-sent__body">{t('contact.sentBody')}</p>
          </div>
          )}

          {/*
            Posts to Web3Forms, which emails the church. It used to post to
            Netlify Forms, which exists only on Netlify, so changing host
            would have left a form that looked perfectly fine and silently
            went nowhere.

            `redirect` must be an absolute URL, and that is a trap while the
            domain still points at the old site: a hard-coded canonical URL
            would send anyone who submits the form to Squarespace. So it
            carries the canonical URL for the no-JavaScript case, and the
            script below rewrites it to wherever the visitor actually is.
          */}
          {hasForm && (
          <form
            class="form"
            name="contact"
            method="POST"
            action="https://api.web3forms.com/submit"
          >
            <input type="hidden" name="access_key" value={church.contact.formKey} />
            <input
              type="hidden"
              name="redirect"
              data-return-to={`/${locale}/contact?sent=1`}
              value={new URL(`/${locale}/contact?sent=1`, Astro.site).href}
            />
            <input type="hidden" name="from_name" value="Waco Chinese Church website" />
            <input
              type="hidden"
              name="subject"
              value={locale === 'en'
                ? 'New message from the church website'
                : '教会网站上的新留言'}
            />
            <input type="hidden" name="locale" value={locale} />
            {/* aria-hidden matters here. visually-hidden only moves this off
                screen, so a screen reader met a fourth field, "Leave this
                empty", among three required ones. Filling it makes Web3Forms
                classify the message as spam and drop it, while the visitor
                still sees the confirmation, because that is driven by ?sent=1
                alone. A stranger’s message vanished and nobody was told.
                Safe to hide: the input is tabindex="-1", so nothing
                focusable is being hidden. */}
            <p class="visually-hidden" aria-hidden="true">
              <label>
                {locale === 'en' ? 'Leave this empty' : '请留空'}
                <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" />
              </label>
            </p>

            <div class="field">
              <label class="field__label" for="topic">{t('contact.topic')}</label>
              <select class="field__input" id="topic" name="topic">
                <option value="visit">{t('contact.topicVisit')}</option>
                <option value="ride">{t('contact.topicRide')}</option>
                <option value="prayer">{t('contact.topicPrayer')}</option>
                <option value="other">{t('contact.topicOther')}</option>
              </select>
            </div>

            <div class="field">
              <label class="field__label" for="name">
                {t('contact.name')}
                <span class="field__req">{t('contact.required')}</span>
              </label>
              <input
                class="field__input"
                id="name"
                name="name"
                type="text"
                autocomplete="name"
                required
              />
            </div>

            <div class="field">
              <label class="field__label" for="email">
                {t('contact.email')}
                <span class="field__req">{t('contact.required')}</span>
              </label>
              <input
                class="field__input"
                id="email"
                name="email"
                type="email"
                autocomplete="email"
                required
              />
            </div>

            <div class="field">
              <label class="field__label" for="message">
                {t('contact.message')}
                <span class="field__req">{t('contact.required')}</span>
              </label>
              <textarea
                class="field__input"
                id="message"
                name="message"
                rows="6"
                required
                aria-describedby="message-hint"></textarea>
              <p class="field__hint" id="message-hint">
                {locale === 'en'
                  ? 'Write in English or Chinese, whichever is easier.'
                  : '中文或英文皆可，请用您更方便的一种。'}
              </p>
            </div>

            <button class="btn btn--solid btn--lg" type="submit">
              {t('contact.send')}
            </button>
          </form>
          )}
        </div>

        {/* ---- Direct routes ---- */}
        <aside class="contact__side" data-reveal>
          {
            church.contact.email && (
              <div class="side-block">
                <h3 class="side-block__title ui">{t('cta.email')}</h3>
                <a class="side-block__email" href={`mailto:${church.contact.email}`}>
                  {church.contact.email}
                </a>
              </div>
            )
          }

          <div class="side-block">
            <h3 class="side-block__title ui">{t('facts.address')}</h3>
            <address class="side-block__address">
              {church.address.line1}<br />
              {church.address.city}, {church.address.state} {church.address.zip}
            </address>
            <a
              class="link-arrow"
              href={church.address.mapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              >{t('facts.directions')}<span class="visually-hidden">, {t('meta.externalLink')}</span></a
            >
          </div>

          {
            social.length > 0 && (
              <div class="side-block">
                <h3 class="side-block__title ui">{t('contact.follow')}</h3>
                <ul class="side-block__links" role="list">
                  {social.map((s) => (
                    <li>
                      <a href={s.url} target="_blank" rel="noopener noreferrer">
                        {pick(s.label, locale) || s.platform}<span class="visually-hidden">, {t('meta.externalLink')}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }

          {/*
            No phone number appears anywhere in the church’s public material,
            so none is offered. An invented or guessed number would be worse
            than no number at all.
          */}
        </aside>
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      /* Web3Forms needs an absolute return URL, and the build only knows the
         canonical one. While the domain still points at the old site that
         would land anyone who submits on Squarespace, so point it at whatever
         origin the visitor is actually on. Runs before any click is possible. */
      try {
        var back = document.querySelector('input[name="redirect"][data-return-to]');
        if (back) back.value = location.origin + back.getAttribute('data-return-to');
      } catch (e) {}

      function reveal() {
        try {
          if (new URLSearchParams(location.search).get('sent') !== '1') return;
          var el = document.getElementById('form-sent');
          if (!el) return;
          el.hidden = false;
          el.focus();
          el.scrollIntoView({ block: 'center' });
        } catch (e) {}
      }
      // Deferred: this script sits mid-document, so at parse time the layout
      // it scrolls to does not exist yet.
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', reveal, { once: true });
      } else {
        reveal();
      }
    })();
  </script>

  {/* ---- Who to ask, by group ---- */}
  {
    contacts.length > 0 && (
      <section class="section" data-surface="warm" aria-labelledby="who-title">
        <div class="shell">
          <SectionHeader
            locale={locale}
            eyebrow={locale === 'en' ? 'By group' : '各团契'}
            title={locale === 'en' ? 'Who to ask' : '可以找谁'}
            lede={locale === 'en'
              ? 'These are the people the church lists for each fellowship. Email the church address above and say who you’re trying to reach.'
              : '以下是教会为各团契列出的联系人。请写信到上方的教会邮箱，并说明您想找哪一位。'}
            id="who-title"
          />
          <ul class="whos" role="list" data-reveal-group>
            {contacts.map((f) => (
              <li class="who">
                <p class="who__group ui">{pick(f.data.name, locale)}</p>
                <p class="who__name">{pick(f.data.contactName, locale)}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <InviteBlock locale={locale} />
</BaseLayout>

<style>
  .contact {
    display: grid;
    gap: var(--s-12);
  }

  /* Shown instead of the form while there is no key. The address has to
     carry the whole page on its own here, so it is given real size rather
     than being another line of body copy. */
  .contact__email-first {
    display: grid;
    gap: var(--s-4);
  }

  .contact__email-lede {
    margin: 0;
    font-size: var(--fs-md);
    line-height: var(--lh-relaxed);
    color: var(--text);
    max-width: var(--measure-narrow);
  }

  .contact__email-big {
    margin: 0;
    font-size: clamp(1.25rem, 3.2vw, 1.75rem);
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .contact__email-big a {
    color: var(--accent-hover);
    text-decoration-thickness: from-font;
  }

  .contact__email-note {
    margin: 0;
    font-size: var(--fs-sm);
    line-height: var(--lh-relaxed);
    color: var(--text-muted);
    max-width: var(--measure-narrow);
  }

  .contact__title {
    margin: 0 0 var(--s-6);
    font-size: var(--fs-xl);
  }

  /* ---------------------------------------------------------------- form */
  .form {
    display: grid;
    gap: var(--s-5);
    max-width: 34rem;
  }

  .field {
    display: grid;
    gap: var(--s-2);
  }

  .field__label {
    font-family: var(--font-ui);
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--text-strong);
  }

  .field__input {
    width: 100%;
    padding: 0.75rem 0.9rem;
    font-family: var(--font-ui);
    font-size: var(--fs-base);
    color: var(--text-strong);
    background: var(--surface-raised);
    border: var(--border-hair) solid var(--rule-strong);
    border-radius: var(--r-md);
    transition: border-color var(--dur-fast) var(--ease-out-soft);
  }

  .field__input:hover {
    border-color: var(--accent);
  }

  .field__input:focus-visible {
    border-color: var(--accent);
    outline: 2.5px solid var(--focus-ring);
    outline-offset: 1px;
  }

  textarea.field__input {
    resize: vertical;
    min-height: 8rem;
    line-height: var(--lh-relaxed);
  }

  .field__hint {
    margin: 0;
    font-size: var(--fs-xs);
    color: var(--text-muted);
  }

  .field__req {
    font-weight: 500;
    color: var(--text-muted);
    font-size: 0.9em;
  }

  .form-sent {
    display: grid;
    gap: var(--s-2);
    margin-block-end: var(--s-6);
    padding: var(--s-6);
    background: var(--accent-faint);
    border-inline-start: 3px solid var(--accent-solid);
    border-radius: var(--r-md);
    max-width: 34rem;
  }

  .form-sent__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--fs-md);
    font-weight: 600;
    color: var(--text-strong);
  }

  .form-sent__body {
    margin: 0;
    font-size: var(--fs-sm);
    line-height: var(--lh-relaxed);
    color: var(--text-muted);
  }

  .form .btn {
    justify-self: start;
  }

  /* ---------------------------------------------------------------- side */
  .contact__side {
    display: grid;
    gap: var(--s-8);
    align-content: start;
  }

  .side-block {
    display: grid;
    gap: var(--s-2);
    justify-items: start;
    padding-block-start: var(--s-4);
    border-block-start: 2px solid var(--accent-solid);
  }

  .side-block__title {
    margin: 0;
    font-size: var(--fs-3xs);
    font-weight: 700;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .side-block__title:lang(zh) {
    text-transform: none;
    letter-spacing: 0.15em;
    font-size: var(--fs-2xs);
  }

  .side-block__email {
    font-family: var(--font-ui);
    font-size: var(--fs-md);
    font-weight: 600;
    color: var(--accent);
    word-break: break-all;
  }

  .side-block__address {
    font-style: normal;
    font-family: var(--font-ui);
    font-size: var(--fs-md);
    line-height: 1.5;
    color: var(--text-strong);
  }

  .side-block__links {
    display: grid;
    gap: var(--s-2);
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-ui);
    font-size: var(--fs-sm);
  }

  .side-block__links a {
    color: var(--accent);
    display: inline-flex;
    align-items: center;
    min-height: 24px;
  }

  /* ---------------------------------------------------------------- whos */
  .whos {
    display: grid;
    gap: var(--s-5);
    margin: 0;
    padding: 0;
    list-style: none;
    grid-template-columns: repeat(auto-fit, minmax(min(15rem, 100%), 1fr));
  }

  .who {
    display: grid;
    gap: 0.2rem;
    padding: var(--s-5);
    background: var(--surface-raised);
    border-radius: var(--r-md);
  }

  .who__group {
    margin: 0;
    font-size: var(--fs-2xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .who__group:lang(zh) {
    text-transform: none;
    letter-spacing: 0.12em;
  }

  .who__name {
    margin: 0;
    font-size: var(--fs-md);
    font-weight: 600;
    color: var(--text-strong);
  }

  @media (min-width: 56rem) {
    .contact {
      grid-template-columns: 1.4fr 0.6fr;
      gap: var(--s-16);
    }
  }
</style>
