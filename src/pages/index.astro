---
/* =========================================================================
   LANGUAGE GATE at "/"
   =========================================================================

   Neither language owns the root. A visitor arriving at
   wacochinesechurch.org is sent to whichever language their browser asks
   for, and their choice is remembered thereafter.

   This is NOT a splash screen. Nobody should ever have to choose a flag
   before they can find out what time church starts. The redirect fires
   before paint in every JS-enabled browser; the visible content below only
   appears if JavaScript is off, and even then it’s a real, usable page
   with the essential facts on it rather than a dead end.

   On Netlify/Cloudflare the `_redirects` file handles this at the edge
   before this page is ever served — this is the belt-and-braces fallback.
   ========================================================================= */
import { getChurch, formatTime, formatWeekdayName } from '@lib/church';

const church = await getChurch();
const sunday = church.gatherings.find((g) => g.id === 'sunday');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Waco Chinese Church · 韦科华人教会</title>
    <meta
      name="description"
      content="A Chinese church in Waco, Texas. Worship in Mandarin, with English interpretation offered to anyone who needs it. 德州韦科的华人教会，主日以华语敬拜，并主动提供英文翻译。"
    />
    <link rel="canonical" href="https://www.wacochinesechurch.org/en" />
    <link rel="alternate" hreflang="en-US" href="https://www.wacochinesechurch.org/en" />
    <link rel="alternate" hreflang="zh-CN" href="https://www.wacochinesechurch.org/zh" />
    <link rel="alternate" hreflang="x-default" href="https://www.wacochinesechurch.org/en" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#14110e" />

    {/* This page is what gets scraped when someone shares the bare domain. */}
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Waco Chinese Church · 韦科华人教会" />
    <meta
      property="og:description"
      content="A Chinese church in Waco, Texas. Sundays at 11:00am, 1801 Gurley Avenue. 德州韦科的华人教会，主日上午十一点在 1801 Gurley Avenue 一同敬拜。"
    />
    <meta property="og:url" content="https://www.wacochinesechurch.org/" />
    <meta property="og:image" content="https://www.wacochinesechurch.org/og-default.png" />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('wcc-lang');
          if (saved !== 'en' && saved !== 'zh') saved = null;
          var langs = navigator.languages || [navigator.language || 'en'];
          var guess = 'en';
          for (var i = 0; i < langs.length; i++) {
            var l = String(langs[i]).toLowerCase();
            if (l.indexOf('zh') === 0) { guess = 'zh'; break; }
            if (l.indexOf('en') === 0) { guess = 'en'; break; }
          }
          location.replace('/' + (saved || guess));
        } catch (e) {
          location.replace('/en');
        }
      })();
    </script>

    <style is:inline>
      :root { color-scheme: dark; }
      body {
        margin: 0;
        min-height: 100svh;
        display: grid;
        place-items: center;
        padding: 2rem 1.5rem;
        background: #14110e;
        color: #e9e2d9;
        font-family: 'Source Serif 4', Georgia, 'Songti SC', serif;
        text-align: center;
      }
      .gate { display: grid; gap: 2rem; max-width: 34rem; }
      h1 { margin: 0; font-size: clamp(1.75rem, 5vw, 2.75rem); line-height: 1.15; font-weight: 600; }
      h1 span { display: block; font-size: 0.55em; color: #f0c489; font-weight: 500; letter-spacing: 0.1em; margin-top: 0.4em; }
      .facts { margin: 0; color: #b3a79b; line-height: 1.7; font-size: 1.05rem; }
      .choose { display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap; }
      .choose a {
        display: inline-block;
        padding: 0.85rem 1.9rem;
        border: 1px solid #c87f2a;
        border-radius: 3px;
        background: #c87f2a;
        color: #14110e;
        font-family: 'Source Sans 3', system-ui, sans-serif;
        font-weight: 600;
        text-decoration: none;
      }
      .choose a + a { background: transparent; color: #f0c489; }
    </style>
  </head>

  <body>
    <div class="gate">
      <h1>
        Waco Chinese Church
        <span lang="zh-CN">韦科华人教会</span>
      </h1>

      <p class="facts">
        {church.address.line1}, {church.address.city}, {church.address.state}
        {church.address.zip}
        {
          sunday && (
            <>
              <br />
              {formatWeekdayName(sunday.day, 'en')}{' '}
              {formatTime(sunday.startTime, 'en')}
              {' · '}
              <span lang="zh-CN">
                {formatWeekdayName(sunday.day, 'zh')}
                {formatTime(sunday.startTime, 'zh')}
              </span>
            </>
          )
        }
      </p>

      <div class="choose">
        <a href="/en">English</a>
        <a href="/zh" lang="zh-CN">中文</a>
      </div>
    </div>
  </body>
</html>
