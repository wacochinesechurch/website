---
import { pick, type Locale } from '@i18n/config';
import { getTimeline } from '@lib/church';
import RichText from '@components/RichText.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const entries = await getTimeline();
---

{/*
  THE SECOND MOTION IDEA — and the last one on the site.

  A warm line runs down the history and fills with light as you scroll it.
  It is the same idea as the hero, told over time instead of in a single
  frame: the light travels from 1993 to now. Implemented as a scroll-driven
  CSS animation, so it costs no JavaScript and no main-thread work, and it
  is switched off entirely for prefers-reduced-motion.
*/}
<div class="timeline-wrap">
  <div class="timeline__rail" aria-hidden="true">
    <div class="timeline__fill"></div>
  </div>

  <ol class="timeline" role="list">
  {
    entries.map((e) => (
      <li class="tl-entry" data-reveal>
        <div class="tl-entry__marker" aria-hidden="true" />
        <p class="tl-entry__year">{e.data.label ? pick(e.data.label, locale) : e.data.year}</p>
        <div class="tl-entry__body">
          <h3 class="tl-entry__title">{pick(e.data.title, locale)}</h3>
          <div class="tl-entry__prose prose">
            <RichText markdown={pick(e.data.body, locale)} />
          </div>
        </div>
      </li>
    ))
  }
  </ol>
</div>

<style>
  .timeline-wrap {
    position: relative;
  }

  .timeline {
    display: grid;
    gap: var(--s-12);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* ---------------------------------------------------------------- rail */
  .timeline__rail {
    position: absolute;
    inset-block: 0.6rem 2rem;
    inset-inline-start: 0.5rem;
    width: 2px;
    background: var(--rule);
    overflow: hidden;
  }

  .timeline__fill {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      var(--c-lamp-500),
      var(--c-lamp-400) 60%,
      var(--c-clay-500)
    );
    transform-origin: top;
    transform: scaleY(0);
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .timeline__fill {
        animation: rail-fill linear both;
        animation-timeline: view();
        animation-range: entry 60% exit 40%;
      }
    }
  }

  @keyframes rail-fill {
    from {
      transform: scaleY(0);
    }
    to {
      transform: scaleY(1);
    }
  }

  /* Without scroll-driven animation support the rail is simply drawn warm
     from the start — the design still reads, it just does not animate. */
  @supports not (animation-timeline: view()) {
    .timeline__fill {
      transform: scaleY(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .timeline__fill {
      transform: scaleY(1);
      animation: none;
    }
  }

  /* --------------------------------------------------------------- entry */
  .tl-entry {
    position: relative;
    display: grid;
    gap: var(--s-3);
    padding-inline-start: var(--s-10);
  }

  .tl-entry__marker {
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 0.55rem;
    width: 1.1rem;
    height: 1.1rem;
    border-radius: var(--r-full);
    background: var(--surface);
    border: 2px solid var(--accent-solid);
    transform: translateX(-0.05rem);
  }

  .tl-entry__year {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--fs-xl);
    font-weight: 300;
    line-height: 1;
    letter-spacing: var(--tracking-tight);
    color: var(--accent);
    font-variant-numeric: lining-nums;
  }

  .tl-entry__year:lang(zh) {
    letter-spacing: 0.02em;
  }

  .tl-entry__body {
    display: grid;
    gap: var(--s-3);
    max-width: var(--measure);
  }

  .tl-entry__title {
    margin: 0;
    font-size: var(--fs-lg);
  }

  .tl-entry__prose {
    color: var(--text);
  }

  .tl-entry__prose :global(p + p) {
    margin-block-start: 1em;
  }

  /* --------------------------------------------------------- wide layout */
  @media (min-width: 56rem) {
    .timeline {
      gap: var(--s-16);
    }

    .timeline__rail {
      inset-inline-start: 9.5rem;
    }

    .tl-entry {
      grid-template-columns: 8rem 1fr;
      gap: var(--s-10);
      align-items: start;
      padding-inline-start: 0;
    }

    .tl-entry__marker {
      inset-inline-start: 9rem;
    }

    .tl-entry__year {
      text-align: end;
      font-size: var(--fs-2xl);
      padding-block-start: 0.05em;
    }
  }
</style>
