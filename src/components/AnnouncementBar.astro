---
import { localePath, pick, type Locale } from '@i18n/config';
import { getLiveAnnouncements, endOfDayInChurchTime } from '@lib/church';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

/* Only announcements whose showUntil date has not passed are returned. If
   there are none, this component renders nothing at all — which is the
   correct state most of the time, and far better than a "latest news" strip
   permanently displaying something from last February. */
const live = await getLiveAnnouncements();
const notice = live[0];
---

{
  notice && (
    <aside
      class="notice"
      data-tone={notice.data.tone}
      data-expires={endOfDayInChurchTime(notice.data.showUntil).toISOString()}
      aria-label={locale === 'en' ? 'Church notice' : '教会通知'}
    >
      <div class="shell shell--wide notice__inner">
        <p class="notice__text">
          <strong>{pick(notice.data.title, locale)}</strong>
          {notice.data.body && pick(notice.data.body, locale) && (
            <span class="notice__body"> {pick(notice.data.body, locale)}</span>
          )}
        </p>

        {notice.data.href && (
          <a
            class="notice__link"
            href={
              notice.data.href.startsWith('http')
                ? notice.data.href
                : localePath(locale, notice.data.href)
            }
          >
            {pick(notice.data.linkLabel, locale) ||
              (locale === 'en' ? 'Details' : '详情')}
          </a>
        )}
      </div>
    </aside>
  )
}

<style>
  .notice {
    background: var(--c-lamp-100);
    color: var(--c-ink-900);
    font-family: var(--font-ui);
    font-size: var(--fs-sm);
    border-block-end: var(--border-hair) solid
      color-mix(in oklab, var(--c-lamp-900) 18%, transparent);
    /* sits above the hero, below the header */
    position: relative;
    z-index: var(--z-raised);
  }

  .notice[data-tone='urgent'] {
    background: var(--c-clay-100);
    border-color: color-mix(in oklab, var(--c-clay-800) 22%, transparent);
  }

  .notice__inner {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-5);
    align-items: baseline;
    justify-content: space-between;
    padding-block: var(--s-3);
  }

  .notice__text {
    margin: 0;
    line-height: var(--lh-relaxed);
  }

  .notice__body {
    color: var(--c-ink-700);
  }

  .notice__link {
    font-weight: 600;
    color: var(--c-lamp-900);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    white-space: nowrap;
  }
</style>
