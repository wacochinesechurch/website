# Netlify / Cloudflare Pages edge redirects.
#
# Language negotiation happens here, before any HTML is served. The `!` forces
# the rule: without it Netlify serves dist/index.html (the no-JS language gate)
# and never applies the redirect, so the negotiation silently never ran.
# The gate page stays in the build as a fallback for hosts without this feature.
/  /zh  302!  Language=zh
/  /en  302!

# Legacy Squarespace URLs -> their new homes, so years of existing links,
# bookmarks and search results keep working.
/home            /en           301
/about           /en/about     301
/sermons         /en/sermons   301
/fellowship      /en/community 301
/new-page        /en/community 301
/church-life     /en/church-life 301
/contacts        /en/contact   301
/giving          /en/give      301
/latest-announcement  /en/church-life  301
/cart            /en           301
/donate          /en/give      301
