# Response headers. Read by BOTH Netlify and Cloudflare Pages, which is why
# they live here rather than in a host-specific config file: moving hosts
# should not mean rewriting the security posture from memory.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()

# Astro content-hashes everything in /_astro, so a changed file gets a changed
# name and can be cached forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts are NOT content-hashed, so they cannot be immutable: a regenerated
# subset would be ignored until the cache expired. A day is long enough to
# avoid revalidating on every page view, short enough that `npm run fonts`
# takes effect quickly. Missing glyphs fall back to a system font meanwhile.
/fonts/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/admin/*
  X-Robots-Tag: noindex
